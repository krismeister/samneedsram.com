# Canonical site origin. Used for absolute og: URLs and pledge links.
SITE_URL=https://samneedsram.com

# HMAC secret for pledge JWT signing. Min 32 random bytes, never commit.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLEDGE_JWT_SECRET=change-me-to-32-plus-random-bytes
